<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS application /api under the Docutracks site. The handlers and modules of the parent
  Web.config (ASP.NET MVC) are inherited by child applications; this file keeps only the
  ASP.NET Core Module. Publish replaces processPath/arguments when needed.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <clear />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Docutracks.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- uploads of POST files (Files:MaxSizeMb + margin) -->
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
